@page "/Chat"
@using MudBlazor
@using Web.Pages.Interactive.Chat.Components
@using Web.Services.Abstractions
@using Web.Dto.Chat

@inject IChatService ChatService
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="chat-root">

    <ChatSidebar IsGenerating="_isGenerating"
                 Threads="_threads"
                 SelectedThreadId="_selectedThreadId"
                 OnSelectThread="SelectThreadAsync"
                 OnNewChat="NewChatAsync" />

    <ChatMain IsGenerating="@_isGenerating"
              Messages="_currentMessages"
              Draft="@_draft"
              DraftChanged="@((string v) => _draft = v)"
              OnSend="SendPromptAsync"
              OnStop="StopGeneration"
              OnLoadMore="LoadMoreAsync" />

</MudPaper>

@code {
    private string _draft = "";
    private bool _isGenerating;

    private long? _selectedThreadId;

    private List<ChatSidebar.ChatThread> _threads = new();
    private List<ChatMain.AiMessage> _currentMessages = new();

    private string? _nextCursor;
    private bool _hasMore;
    private bool _loadingMsgs;

    protected override async Task OnInitializedAsync()
    {
        await LoadThreadsAsync();
    }

    // =========================
    // THREADS
    // =========================
    private async Task LoadThreadsAsync()
    {
        var (resp, status) = await ChatService.GetThreadByUserAsync();
        if (status is < 200 or >= 300)
        {
            Snackbar.Add(resp?.Message ?? "Falha ao carregar conversas.", Severity.Error);
            return;
        }

        var list = resp?.Data ?? new List<ChatThreadOutDto?>();

        _threads = list
            .Where(x => x is not null)
            .Select(x => x!)
            .Select(t => new ChatSidebar.ChatThread(t.Id, t.Title ?? "New chat", t.UpdatedAt ?? "Now"))
            .ToList();

        if (_threads.Count > 0)
        {
            _selectedThreadId = _threads[0].Id;
            await LoadMsgsRecentAsync(_selectedThreadId.Value);
        }
        else
        {
            await NewChatAsync();
        }
    }

    private async Task SelectThreadAsync(long id)
    {
        if (_isGenerating) return;

        _selectedThreadId = id;
        _draft = "";

        await LoadMsgsRecentAsync(id);
    }

    private async Task NewChatAsync()
    {
        if (_isGenerating) return;

        var (resp, status) = await ChatService.CreateThreadAsync("New chat");
        if (status is < 200 or >= 300)
        {
            Snackbar.Add(resp?.Message ?? "Falha ao criar conversa.", Severity.Error);
            return;
        }

        var thread = resp?.Data;
        if (thread is null)
        {
            Snackbar.Add("Thread não retornou do backend.", Severity.Error);
            return;
        }

        _threads.Insert(0, new ChatSidebar.ChatThread(thread.Id, thread.Title ?? "New chat", thread.UpdatedAt ?? "Now"));
        _selectedThreadId = thread.Id;
        _draft = "";

        await LoadMsgsRecentAsync(thread.Id);
    }

    // =========================
    // MESSAGES (ListMsgsAsync)
    // =========================
    private async Task LoadMsgsRecentAsync(long threadId)
    {
        _loadingMsgs = true;
        try
        {
            var input = new MsgListInDto(ThreadId: threadId, Limit: 50, BeforeCursor: null);

            var (resp, status) = await ChatService.ListMsgsAsync(input);

            if (status is < 200 or >= 300)
            {
                Snackbar.Add(resp?.Message ?? "Falha ao carregar mensagens.", Severity.Error);
                _currentMessages = new();
                _hasMore = false;
                _nextCursor = null;
                _isGenerating = false;
                return;
            }

            var data = resp?.Data;
            if (data is null)
            {
                _currentMessages = new();
                _hasMore = false;
                _nextCursor = null;
                _isGenerating = false;
                return;
            }

            _hasMore = data.HasMore;
            _nextCursor = data.NextCursor;

            _currentMessages = data.Items
                .OrderBy(m => m.CreatedAt)
                .Select(ToUiMessage)
                .ToList();

            // Se a última mensagem for do bot e estiver vazia, considera "gerando"
            _isGenerating = _currentMessages.LastOrDefault() is { Role: ChatMain.Role.Assistant } last
                            && string.IsNullOrWhiteSpace(last.Text);
        }
        finally
        {
            _loadingMsgs = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_loadingMsgs) return;
        if (_selectedThreadId is null) return;
        if (!_hasMore) return;
        if (string.IsNullOrWhiteSpace(_nextCursor)) return;

        _loadingMsgs = true;
        try
        {
            var threadId = _selectedThreadId.Value;

            var input = new MsgListInDto(ThreadId: threadId, Limit: 50, BeforeCursor: _nextCursor);
            var (resp, status) = await ChatService.ListMsgsAsync(input);

            if (status is < 200 or >= 300)
            {
                Snackbar.Add(resp?.Message ?? "Falha ao carregar mais mensagens.", Severity.Error);
                return;
            }

            var data = resp?.Data;
            if (data is null) return;

            _hasMore = data.HasMore;
            _nextCursor = data.NextCursor;

            var older = data.Items
                .OrderBy(m => m.CreatedAt)
                .Select(ToUiMessage)
                .ToList();

            var existingIds = _currentMessages.Select(x => x.Id).ToHashSet();
            var toInsert = older.Where(x => !existingIds.Contains(x.Id)).ToList();

            _currentMessages.InsertRange(0, toInsert);
        }
        finally
        {
            _loadingMsgs = false;
            StateHasChanged();
        }
    }

    // =========================
    // SEND (real)
    // =========================
private async Task SendPromptAsync()
{
    if (_selectedThreadId is null) return;
    if (string.IsNullOrWhiteSpace(_draft)) return;
    if (_isGenerating) return;

    var threadId = _selectedThreadId.Value;
    var text = _draft.Trim();
    
    
    _draft = "";
    await InvokeAsync(StateHasChanged);
    // ✅ 1) Adiciona imediatamente a msg do usuário + placeholder do bot
    var now = DateTime.Now;
    var time = now.ToString("HH:mm");

    var tempUserId = -DateTime.UtcNow.Ticks;
    var tempBotId = tempUserId - 1;

    _currentMessages.Add(new ChatMain.AiMessage(ChatMain.Role.User, text, time, tempUserId));
    _currentMessages.Add(new ChatMain.AiMessage(ChatMain.Role.Assistant, "", time, tempBotId));

    _isGenerating = true;
    StateHasChanged(); // força render do skeleton + botão Stop

    try
    {
        var input = new SendMsgInDto(ThreadId: threadId, Content: text);
        var (resp, status) = await ChatService.SendMsgAsync(input);

        if (status is < 200 or >= 300)
        {
            Snackbar.Add(resp?.Message ?? "Falha ao enviar mensagem.", Severity.Error);

            // remove os temporários
            _currentMessages.RemoveAll(m => m.Id == tempUserId || m.Id == tempBotId);
            _isGenerating = false;
            StateHasChanged();
            return;
        }

        var data = resp?.Data;
        if (data is null)
        {
            Snackbar.Add("Resposta inválida do servidor.", Severity.Error);

            _currentMessages.RemoveAll(m => m.Id == tempUserId || m.Id == tempBotId);
            _isGenerating = false;
            StateHasChanged();
            return;
        }

        // ✅ 2) Substitui os temporários pelos persistidos
        var userUi = ToUiMessage(data.UserMessage);
        var botUi = data.BotMessage is not null
            ? ToUiMessage(data.BotMessage)
            : new ChatMain.AiMessage(ChatMain.Role.Assistant, "", time, tempBotId);

        for (int i = 0; i < _currentMessages.Count; i++)
        {
            if (_currentMessages[i].Id == tempUserId) _currentMessages[i] = userUi;
            if (_currentMessages[i].Id == tempBotId) _currentMessages[i] = botUi;
        }

        // ✅ 3) Mantém "gerando" apenas se o bot ainda está vazio
        _isGenerating = string.IsNullOrWhiteSpace(botUi.Text);

        // título só muda 1 vez (primeira msg)
        var currentThread = _threads.FirstOrDefault(t => t.Id == threadId);
        if (currentThread is not null && currentThread.Title == "New chat")
        {
            var firstTitle = text.Length > 28 ? text[..28] + "…" : text;
            var updated = currentThread with { Title = firstTitle, UpdatedAt = "Now" };

            _threads.RemoveAll(t => t.Id == threadId);
            _threads.Insert(0, updated);
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add(ex.Message, Severity.Error);

        _currentMessages.RemoveAll(m => m.Id == tempUserId || m.Id == tempBotId);
        _isGenerating = false;
    }
    finally
    {
        StateHasChanged();
    }
}

    // =========================
    // STOP (remove placeholder vazio)
    // =========================
    private void StopGeneration()
    {
        var last = _currentMessages.LastOrDefault();
        if (last is not null &&
            last.Role == ChatMain.Role.Assistant &&
            string.IsNullOrWhiteSpace(last.Text))
        {
            _currentMessages.Remove(last);
        }

        _isGenerating = false;
        StateHasChanged();
    }

    // =========================
    // Mapper DTO -> UI
    // =========================
    private ChatMain.AiMessage ToUiMessage(MsgOutDto m)
    {
        var role = m.Type == TypeMsg.User
            ? ChatMain.Role.User
            : ChatMain.Role.Assistant;

        var time = m.CreatedAt.LocalDateTime.ToString("HH:mm");

        return new ChatMain.AiMessage(role, m.Content, time, m.Id);
    }
}
