@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

@inject NavigationManager NavigationManager

<MudNavMenu>
    <MudNavLink Href="" Icon="@Icons.Material.Filled.Lock">
        Auth
    </MudNavLink>
    <MudNavLink Href="Chat" Icon="@Icons.Material.Filled.Chat">
        Chat
    </MudNavLink>

    <MudNavGroup Title="User Management"
                 Icon="@Icons.Material.Filled.AdminPanelSettings"
                 Expanded="true">

        <MudNavLink Href="Account/Users"
                    Icon="@Icons.Material.Filled.Group">
            Users
        </MudNavLink>

        <MudNavLink Href="Account/Permissions"
                    Icon="@Icons.Material.Filled.Security">
            Permissions
        </MudNavLink>

    </MudNavGroup>
</MudNavMenu>


@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
}

