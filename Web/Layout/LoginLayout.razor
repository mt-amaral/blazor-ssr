@using MudBlazor
@inherits LayoutComponentBase
<MudThemeProvider Theme="Configuration.Theme" IsDarkMode="Configuration.IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider
    FullWidth="true"
    MaxWidth="MaxWidth.ExtraExtraLarge"
    CloseButton="true"
    BackdropClick="false"
    NoHeader="true"
    Position="DialogPosition.Center"
    CloseOnEscapeKey="true"
    BackgroundClass="my-custom-class"/>
<MudSnackbarProvider/>

<MudLayout>
    <MudMainContent>
        <MudAppBar Elevation="0" Color="Color.Transparent">
            <MudSpacer />
        </MudAppBar>
        @Body
    </MudMainContent>
</MudLayout>

